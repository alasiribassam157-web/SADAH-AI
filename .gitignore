# Python
venv/
.venv/
__pycache__/
*.pyc

# Model weights: only the SERVED stable brains (models/router.pt, models/coder.pt) are committed.
# Every other trained version lives in models/registry/<brain>/vN/model.pt on the machine that trained it;
# its meta.json, stable.json and history.jsonl ARE committed (they are the audit trail, see docs/OPERATIONS.md).
checkpoints/
*.pt
!models/router.pt
!models/coder.pt
models/registry/**/*.pt
models/.*.tmp
models/registry/**/*.tmp
workspace/
logs/
.pytest_cache/

# Developer-only (stays on the laptop)
devtools/
.nexus_cloud.json
data/cloud_questions.jsonl
.render_hook

# Secrets & local links
.env
.nexus_token
PERMANENT_LINK.txt
CLOUD_LINK.txt

# Tunnel binaries
deploy/bin/

# Node / editors
node_modules/
.vscode/
.idea/
data/corpus/

# SADAH private keys (the old names stay ignored on purpose)
.sadah_cloud.json
.sadah_token
